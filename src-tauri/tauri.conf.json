{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahyarVPN",
  "mainBinaryName": "mahyarvpn",
  "version": "1.0.0",
  "identifier": "com.mahyar.vpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MahyarVPN",
        "width": 400,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "bin/sing-box.exe": "sing-box.exe" },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
